#!/bin/sh
set -eu

usage() {
  cat <<'EOF'
Usage: scripts/migaki-advise [--include-smoke] [--source-root <path>]

Print next-session advice from the newest local Migaki execution graph.

Options:
  --include-smoke       Include deterministic smoke and fixture runs.
  --source-root <path>  Local Migaki store root. Defaults to .migaki.
  -h, --help            Show this help.
EOF
}

include_smoke=0
source_root=

while [ "$#" -gt 0 ]; do
  case "$1" in
    --include-smoke)
      include_smoke=1
      ;;
    --source-root)
      shift
      if [ "$#" -eq 0 ]; then
        printf '%s\n' "--source-root requires a value." >&2
        exit 2
      fi
      source_root=$1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf '%s\n' "Unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
  shift
done

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ -z "$source_root" ]; then
  source_root="$ROOT_DIR/.migaki"
else
  case "$source_root" in
    /*) ;;
    *) source_root="$ROOT_DIR/$source_root" ;;
  esac
fi
RUNS_DIR="$source_root/runs"
RUNTIME_ENTRYPOINT="$ROOT_DIR/packages/runtime/dist/execution.js"

print_no_evidence_advice() {
  detail=$1
  cat <<EOF
# Migaki Session Advice

Top signal: no local evidence

Next Codex move:
- $detail
- Run \`mise run migaki:doctor\` to verify hook trust, hook build output, store writability, and latest real-run selection.
- After trusting the project hooks, run one normal Codex turn in this repository, then rerun \`mise run migaki:advise\`.

Safety:
- No behavior should be skipped, cached, replayed, or parallelized from missing evidence.
EOF
}

is_smoke_run_id() {
  case "$1" in
    codex-turn-migaki-smoke-*|codex-session-migaki-smoke-*) return 0 ;;
    *) return 1 ;;
  esac
}

latest_graph_path() {
  if [ ! -d "$RUNS_DIR" ]; then
    return 0
  fi

  find "$RUNS_DIR" -mindepth 2 -maxdepth 2 -type f -name graph.json -exec ls -t {} + 2>/dev/null | while IFS= read -r candidate; do
    run_id=$(basename -- "$(dirname -- "$candidate")")
    if [ "$include_smoke" -eq 1 ] || ! is_smoke_run_id "$run_id"; then
      printf '%s\n' "$candidate"
    fi
  done | sed -n '1p'
}

has_any_graphs() {
  [ -d "$RUNS_DIR" ] && [ -n "$(find "$RUNS_DIR" -mindepth 2 -maxdepth 2 -type f -name graph.json 2>/dev/null | sed -n '1p')" ]
}

if [ ! -d "$RUNS_DIR" ]; then
  print_no_evidence_advice "No Migaki runs were found at ${source_root}/runs."
  exit 0
fi

graph_path=$(latest_graph_path)

if [ -z "$graph_path" ]; then
  if has_any_graphs; then
    print_no_evidence_advice "Only Migaki smoke or fixture graphs were found; pass --include-smoke to inspect them."
  else
    print_no_evidence_advice "No Migaki graph.json files were found under ${source_root}/runs."
  fi
  exit 0
fi

if [ ! -f "$RUNTIME_ENTRYPOINT" ]; then
  printf '%s\n' "Built runtime entrypoint was not found: $RUNTIME_ENTRYPOINT" >&2
  printf '%s\n' "Run this through mise with \`mise run migaki:advise\`, or run \`mise run build\` first." >&2
  exit 1
fi

cd "$ROOT_DIR"

node --input-type=module - "$graph_path" <<'EOF'
import { readFileSync } from "node:fs";
import { renderExecutionAdvice } from "./packages/runtime/dist/execution.js";

const graphPath = process.argv[2];

if (graphPath === undefined) {
  throw new Error("graph path argument is required");
}

const graph = JSON.parse(readFileSync(graphPath, "utf8"));

console.log(renderExecutionAdvice(graph));
EOF
