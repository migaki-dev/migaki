#!/bin/sh
set -eu

usage() {
  cat <<'EOF'
Usage: scripts/migaki-smoke

Run a trusted Codex CLI smoke turn, assert it writes a Migaki report, then
assert a deterministic file-reuse Codex hook fixture surfaces opportunity
evidence.

The project Codex hooks must already be reviewed and trusted with /hooks.
EOF
}

case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
  "")
    ;;
  *)
    printf '%s\n' "Unknown argument: $1" >&2
    usage >&2
    exit 2
    ;;
esac

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
OUTPUT_FILE="${TMPDIR:-/tmp}/migaki-codex-smoke-$$.jsonl"
REPORT_SNAPSHOT="${TMPDIR:-/tmp}/migaki-codex-smoke-reports-$$.txt"
HOOK_FILE="$ROOT_DIR/packages/codex/dist/hook.js"
FIXTURE_TURN_ID="migaki-smoke-file-reuse-$$"
FIXTURE_RUN_DIR="$ROOT_DIR/.migaki/runs/codex-turn-$FIXTURE_TURN_ID"
FIXTURE_REPORT="$FIXTURE_RUN_DIR/report.md"

cleanup() {
  rm -f "$OUTPUT_FILE" "$REPORT_SNAPSHOT"
}
trap cleanup EXIT HUP INT TERM

if ! command -v codex >/dev/null 2>&1; then
  cat >&2 <<'EOF'
Codex CLI was not found on PATH.

Run this through mise with `mise run migaki:smoke`, or source scripts/env first.
EOF
  exit 1
fi

cd "$ROOT_DIR"

snapshot_reports() {
  if [ -d "$ROOT_DIR/.migaki/runs" ]; then
    find "$ROOT_DIR/.migaki/runs" -path "$ROOT_DIR/.migaki/runs/codex-turn-*/report.md" -type f | sort > "$REPORT_SNAPSHOT"
  else
    : > "$REPORT_SNAPSHOT"
  fi
}

find_new_real_report() {
  if [ ! -d "$ROOT_DIR/.migaki/runs" ]; then
    return 0
  fi

  find "$ROOT_DIR/.migaki/runs" -path "$ROOT_DIR/.migaki/runs/codex-turn-*/report.md" -type f | sort | while IFS= read -r report_path; do
    if ! grep -Fqx -- "$report_path" "$REPORT_SNAPSHOT"; then
      printf '%s\n' "$report_path"
    fi
  done | tail -1
}

snapshot_reports

codex -a never exec --json -C "$ROOT_DIR" -s read-only "Run pwd with the shell tool, then reply exactly: MIGAKI_HOOK_SMOKE" > "$OUTPUT_FILE" 2>&1

if ! grep -Fq "MIGAKI_HOOK_SMOKE" "$OUTPUT_FILE"; then
  printf '%s\n' "Codex smoke turn did not return the expected marker." >&2
  tail -40 "$OUTPUT_FILE" >&2
  exit 1
fi

REAL_REPORT=$(find_new_real_report)

if [ -z "$REAL_REPORT" ]; then
  printf '%s\n' "Codex smoke turn did not write a new Migaki report." >&2
  tail -40 "$OUTPUT_FILE" >&2
  exit 1
fi

REAL_RUN_DIR=$(dirname "$REAL_REPORT")

require_real_artifact() {
  artifact_path=$1
  if [ ! -f "$artifact_path" ]; then
    printf '%s\n' "Expected real Codex smoke artifact was not written: $artifact_path" >&2
    printf '%s\n' "Report path: $REAL_REPORT" >&2
    exit 1
  fi
}

require_real_report_text() {
  text=$1
  if ! grep -Fq -- "$text" "$REAL_REPORT"; then
    printf '%s\n' "Expected real Codex smoke report to contain: $text" >&2
    printf '%s\n' "Report path: $REAL_REPORT" >&2
    exit 1
  fi
}

reject_real_artifact_text() {
  text=$1
  for artifact_path in "$REAL_RUN_DIR/events.jsonl" "$REAL_RUN_DIR/graph.json" "$REAL_REPORT"; do
    if grep -Fq -- "$text" "$artifact_path"; then
      printf '%s\n' "Real Codex smoke artifact unexpectedly contained: $text" >&2
      printf '%s\n' "Artifact path: $artifact_path" >&2
      printf '%s\n' "Report path: $REAL_REPORT" >&2
      exit 1
    fi
  done
}

require_real_artifact "$REAL_RUN_DIR/events.jsonl"
require_real_artifact "$REAL_RUN_DIR/graph.json"
require_real_artifact "$REAL_REPORT"
require_real_report_text "# Migaki Execution Report"
require_real_report_text "## Opportunity Summary"
require_real_report_text "- prompt: User prompt"
require_real_report_text ": Bash ("
require_real_report_text "- turn: Turn completed"
reject_real_artifact_text "Run pwd with the shell tool"
reject_real_artifact_text "MIGAKI_HOOK_SMOKE"
reject_real_artifact_text "$ROOT_DIR"

run_hook_fixture() {
  hook_event_name=$1
  tool_use_id=${2:-}
  offset=${3:-}

  case "$hook_event_name" in
    UserPromptSubmit)
      printf '{"cwd":"%s","hook_event_name":"UserPromptSubmit","model":"gpt-5.1-codex","permission_mode":"default","prompt":"Create deterministic file reuse smoke evidence.","session_id":"migaki-smoke","transcript_path":null,"turn_id":"%s"}\n' "$ROOT_DIR" "$FIXTURE_TURN_ID"
      ;;
    PreToolUse|PostToolUse)
      if [ "$hook_event_name" = "PostToolUse" ]; then
        printf '{"cwd":"%s","hook_event_name":"PostToolUse","model":"gpt-5.1-codex","permission_mode":"default","session_id":"migaki-smoke","tool_input":{"file_path":"README.md","offset":%s},"tool_name":"Read","tool_response":{"status":"ok"},"tool_use_id":"%s","transcript_path":null,"turn_id":"%s"}\n' "$ROOT_DIR" "$offset" "$tool_use_id" "$FIXTURE_TURN_ID"
      else
        printf '{"cwd":"%s","hook_event_name":"PreToolUse","model":"gpt-5.1-codex","permission_mode":"default","session_id":"migaki-smoke","tool_input":{"file_path":"README.md","offset":%s},"tool_name":"Read","tool_use_id":"%s","transcript_path":null,"turn_id":"%s"}\n' "$ROOT_DIR" "$offset" "$tool_use_id" "$FIXTURE_TURN_ID"
      fi
      ;;
    Stop)
      printf '{"cwd":"%s","hook_event_name":"Stop","last_assistant_message":"Done.","model":"gpt-5.1-codex","permission_mode":"default","session_id":"migaki-smoke","stop_hook_active":false,"transcript_path":null,"turn_id":"%s"}\n' "$ROOT_DIR" "$FIXTURE_TURN_ID"
      ;;
    *)
      printf '%s\n' "Unsupported fixture hook event: $hook_event_name" >&2
      exit 2
      ;;
  esac | node "$HOOK_FILE"
}

run_hook_fixture UserPromptSubmit
run_hook_fixture PreToolUse read-1 1
run_hook_fixture PostToolUse read-1 1
run_hook_fixture PreToolUse read-2 2
run_hook_fixture PostToolUse read-2 2
run_hook_fixture Stop

if [ ! -f "$FIXTURE_REPORT" ]; then
  printf '%s\n' "Expected deterministic Migaki report was not written: $FIXTURE_REPORT" >&2
  exit 1
fi

require_report_text() {
  text=$1
  if ! grep -Fq -- "$text" "$FIXTURE_REPORT"; then
    printf '%s\n' "Expected deterministic Migaki report to contain: $text" >&2
    printf '%s\n' "Report path: $FIXTURE_REPORT" >&2
    exit 1
  fi
}

reject_report_text() {
  text=$1
  if grep -Fq -- "$text" "$FIXTURE_REPORT"; then
    printf '%s\n' "Deterministic Migaki report unexpectedly contained: $text" >&2
    printf '%s\n' "Report path: $FIXTURE_REPORT" >&2
    exit 1
  fi
}

require_report_text "## Opportunity Summary"
require_report_text "- Total: 2"
require_report_text "- Actionability: actionable 0, needs_review 1, blocked 1"
require_report_text "- Top recommendation: needs_review file_reuse on nodes tool-read-1, tool-read-2"
require_report_text "file_reuse"
require_report_text "file fingerprint was observed 2 times"
require_report_text "Raw file paths are omitted"
reject_report_text "README.md"

"$ROOT_DIR/scripts/migaki-latest-report"
