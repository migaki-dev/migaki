#!/bin/sh
set -eu

usage() {
  cat <<'EOF'
Usage: scripts/migaki-latest-report [--path] [--include-smoke] [--source-root <path>]

Print the newest Migaki Codex execution report from .migaki/runs.

Options:
  --path                Print only the report path.
  --include-smoke       Include deterministic smoke and fixture runs.
  --source-root <path>  Local Migaki store root. Defaults to .migaki.
  -h, --help            Show this help.
EOF
}

include_smoke=0
path_only=0
source_root=

while [ "$#" -gt 0 ]; do
  case "$1" in
    --path)
      path_only=1
      ;;
    --include-smoke)
      include_smoke=1
      ;;
    --source-root)
      shift
      if [ "$#" -eq 0 ]; then
        printf '%s\n' "--source-root requires a value." >&2
        exit 2
      fi
      source_root=$1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf '%s\n' "Unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
  shift
done

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ -z "$source_root" ]; then
  source_root="$ROOT_DIR/.migaki"
else
  case "$source_root" in
    /*) ;;
    *) source_root="$ROOT_DIR/$source_root" ;;
  esac
fi
RUNS_DIR="$source_root/runs"

is_smoke_run_id() {
  case "$1" in
    codex-turn-migaki-smoke-*|codex-session-migaki-smoke-*) return 0 ;;
    *) return 1 ;;
  esac
}

latest_report_path() {
  if [ ! -d "$RUNS_DIR" ]; then
    return 0
  fi

  find "$RUNS_DIR" -mindepth 2 -maxdepth 2 -type f -name report.md -exec ls -t {} + 2>/dev/null | while IFS= read -r candidate; do
    run_id=$(basename -- "$(dirname -- "$candidate")")
    if [ "$include_smoke" -eq 1 ] || ! is_smoke_run_id "$run_id"; then
      printf '%s\n' "$candidate"
    fi
  done | sed -n '1p'
}

has_any_reports() {
  [ -d "$RUNS_DIR" ] && [ -n "$(find "$RUNS_DIR" -mindepth 2 -maxdepth 2 -type f -name report.md 2>/dev/null | sed -n '1p')" ]
}

if [ ! -d "$RUNS_DIR" ]; then
  printf '%s\n' "No Migaki runs found at ${source_root}/runs." >&2
  exit 1
fi

report_path=$(latest_report_path)

if [ -z "$report_path" ]; then
  if has_any_reports; then
    printf '%s\n' "Only Migaki smoke or fixture reports were found under ${source_root}/runs. Pass --include-smoke to inspect them." >&2
  else
    printf '%s\n' "No Migaki report.md files found under ${source_root}/runs." >&2
  fi
  exit 1
fi

if [ "$path_only" -eq 1 ]; then
  printf '%s\n' "$report_path"
  exit 0
fi

printf 'Latest Migaki report: %s\n\n' "$report_path"
cat "$report_path"
