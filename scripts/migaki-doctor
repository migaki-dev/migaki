#!/bin/sh
set -eu

usage() {
  cat <<'EOF'
Usage: scripts/migaki-doctor [--source-root <path>] [--codex-config <path>]

Diagnose whether this worktree is ready for Migaki Codex dogfooding.

Options:
  --source-root <path>   Local Migaki store root. Defaults to .migaki.
  --codex-config <path>  Codex config path. Defaults to ~/.codex/config.toml.
  -h, --help             Show this help.
EOF
}

source_root=
codex_config=

while [ "$#" -gt 0 ]; do
  case "$1" in
    --source-root)
      shift
      if [ "$#" -eq 0 ]; then
        printf '%s\n' "--source-root requires a value." >&2
        exit 2
      fi
      source_root=$1
      ;;
    --codex-config)
      shift
      if [ "$#" -eq 0 ]; then
        printf '%s\n' "--codex-config requires a value." >&2
        exit 2
      fi
      codex_config=$1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf '%s\n' "Unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
  shift
done

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
HOOKS_FILE="$ROOT_DIR/.codex/hooks.json"
HOOK_ENTRYPOINT="$ROOT_DIR/packages/codex/dist/hook.js"

if [ -z "$source_root" ]; then
  source_root="$ROOT_DIR/.migaki"
else
  case "$source_root" in
    /*) ;;
    *) source_root="$ROOT_DIR/$source_root" ;;
  esac
fi

if [ -z "$codex_config" ]; then
  codex_config="${HOME:-}/.codex/config.toml"
fi

RUNS_DIR="$source_root/runs"
hard_failures=0

ok() {
  printf '%s\n' "OK   $*"
}

warn() {
  printf '%s\n' "WARN $*"
}

fail() {
  printf '%s\n' "FAIL $*"
  hard_failures=$((hard_failures + 1))
}

is_smoke_run_id() {
  case "$1" in
    codex-turn-migaki-smoke-*|codex-session-migaki-smoke-*) return 0 ;;
    *) return 1 ;;
  esac
}

reports() {
  if [ ! -d "$RUNS_DIR" ]; then
    return 0
  fi

  find "$RUNS_DIR" -mindepth 2 -maxdepth 2 -type f -name report.md -exec ls -t {} + 2>/dev/null
}

graphs() {
  if [ ! -d "$RUNS_DIR" ]; then
    return 0
  fi

  find "$RUNS_DIR" -mindepth 2 -maxdepth 2 -type f -name graph.json -exec ls -t {} + 2>/dev/null
}

latest_real_report() {
  reports | while IFS= read -r candidate; do
    run_id=$(basename -- "$(dirname -- "$candidate")")
    if ! is_smoke_run_id "$run_id"; then
      printf '%s\n' "$candidate"
    fi
  done | sed -n '1p'
}

latest_any_report() {
  reports | sed -n '1p'
}

latest_real_graph() {
  graphs | while IFS= read -r candidate; do
    run_id=$(basename -- "$(dirname -- "$candidate")")
    if ! is_smoke_run_id "$run_id"; then
      printf '%s\n' "$candidate"
    fi
  done | sed -n '1p'
}

project_trusted() {
  [ -f "$codex_config" ] || return 1

  awk -v project="$ROOT_DIR" '
    $0 == "[projects.\"" project "\"]" {
      in_project = 1
      next
    }
    /^\[/ {
      in_project = 0
    }
    in_project && $0 ~ /^trust_level = "trusted"/ {
      found = 1
    }
    END {
      exit found ? 0 : 1
    }
  ' "$codex_config"
}

hook_trust_count() {
  [ -f "$codex_config" ] || {
    printf '%s\n' 0
    return
  }

  grep -F "[hooks.state.\"$HOOKS_FILE:" "$codex_config" 2>/dev/null | wc -l | tr -d ' '
}

store_writable() {
  mkdir -p "$source_root"
  probe="$source_root/.migaki-doctor-write-test-$$"
  : > "$probe"
  rm -f "$probe"
}

printf '%s\n' "# Migaki Dogfood Doctor"
printf '%s\n\n' "Repository: $ROOT_DIR"

git_root=$(git -C "$ROOT_DIR" rev-parse --show-toplevel 2>/dev/null || true)
if [ "$git_root" = "$ROOT_DIR" ]; then
  ok "Current path is the Git repository root."
else
  fail "Current path is not the Git repository root reported by git."
fi

if [ -f "$HOOKS_FILE" ]; then
  ok "Project hook definitions exist at .codex/hooks.json."
else
  fail "Project hook definitions are missing at .codex/hooks.json."
fi

if [ -f "$HOOK_ENTRYPOINT" ]; then
  ok "Built hook entrypoint exists at packages/codex/dist/hook.js."
else
  fail "Built hook entrypoint is missing; run \`mise run build\`."
fi

if store_writable; then
  ok "Migaki store is writable at $source_root."
else
  fail "Migaki store is not writable at $source_root."
fi

if project_trusted; then
  ok "Codex project trust is recorded for this exact worktree path."
else
  warn "Codex project trust was not found for this exact worktree path in $codex_config."
fi

trusted_hooks=$(hook_trust_count)
if [ "$trusted_hooks" -ge 10 ]; then
  ok "Codex hook trust entries are recorded for this exact hooks file."
elif [ "$trusted_hooks" -gt 0 ]; then
  warn "Only $trusted_hooks Codex hook trust entries were found for this hooks file; review /hooks again."
else
  warn "No Codex hook trust entries were found for this hooks file; review and trust project hooks in Codex."
fi

real_report=$(latest_real_report)
any_report=$(latest_any_report)
real_graph=$(latest_real_graph)

if [ -n "$real_report" ]; then
  ok "Latest real Migaki report: $real_report"
elif [ -n "$any_report" ]; then
  warn "Only smoke or fixture Migaki reports were found; normal Codex turns are not yet being observed."
else
  warn "No Migaki reports were found yet."
fi

if [ -n "$real_graph" ]; then
  ok "Default advice source is real run $(basename -- "$(dirname -- "$real_graph")")."
elif [ -n "$any_report" ]; then
  warn "Default advice has no real run yet; smoke fixtures are ignored unless --include-smoke is used."
else
  warn "Default advice has no run evidence yet."
fi

if [ "$hard_failures" -eq 0 ]; then
  printf '\n%s\n' "Doctor finished with no hard failures."
  exit 0
fi

printf '\n%s\n' "Doctor found $hard_failures hard failure(s)."
exit 1
