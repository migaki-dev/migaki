#!/bin/sh
set -eu

MISE_MIN_VERSION="2026.6.14"
MISE_INSTALL_VERSION="v2026.6.14"

force=0
needs_refresh=0
mise_installed_or_updated=0

usage() {
  cat <<'EOF'
Usage: scripts/bootstrap [--force]

Bootstraps a Migaki development machine idempotently.

The script is POSIX sh and can be launched from sh, bash, zsh, fish, or
nushell. It supports Unix-like systems across common x86, x64, and ARM
architectures. Homebrew installation is offered only on macOS. mise is
installed with the native mise installer. Colima installation is offered when
Homebrew is available.

Every system installation step asks before installing or updating:

  - Homebrew on macOS
  - mise
  - Colima through Homebrew

After tool setup, the script refreshes its own environment, trusts the local
mise config, installs and upgrades project tools, then runs `mise run setup`
and `mise run check`.

Options:
  -f, --force   Re-run installer/update steps even when tools already exist.
  -h, -?, --help
                Show this help.
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    -f|--force)
      force=1
      ;;
    -h|-\?|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
  shift
done

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
HOME_DIR=${HOME:?HOME must be set}
OS_NAME=$(uname -s 2>/dev/null || printf unknown)
ARCH_NAME=$(uname -m 2>/dev/null || printf unknown)

log() {
  printf '%s\n' "$*"
}

have() {
  command -v "$1" >/dev/null 2>&1
}

has_tty() {
  [ -r /dev/tty ] && [ -w /dev/tty ]
}

ask_yes_no() {
  prompt=$1

  if ! has_tty; then
    log "$prompt [Y/n]"
    log "No interactive terminal is available; skipping."
    return 1
  fi

  printf '%s [Y/n] ' "$prompt" >/dev/tty
  IFS= read -r answer </dev/tty || answer=

  case "$answer" in
    ""|Y|y|yes|YES|Yes)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

append_once() {
  file=$1
  line=$2

  dir=$(dirname -- "$file")
  [ -d "$dir" ] || mkdir -p "$dir"
  [ -f "$file" ] || : > "$file"

  if ! grep -Fqx "$line" "$file"; then
    printf '\n%s\n' "$line" >> "$file"
    log "Updated $file"
  fi
}

version_ge() {
  actual=$(printf '%s' "$1" | sed 's/^v//')
  required=$(printf '%s' "$2" | sed 's/^v//')
  awk -v actual="$actual" -v required="$required" '
    BEGIN {
      split(actual, a, ".")
      split(required, r, ".")
      for (i = 1; i <= 3; i++) {
        ai = (a[i] == "" ? 0 : a[i]) + 0
        ri = (r[i] == "" ? 0 : r[i]) + 0
        if (ai > ri) exit 0
        if (ai < ri) exit 1
      }
      exit 0
    }
  '
}

detect_shell_name() {
  shell_path=${SHELL:-}
  shell_name=

  if [ -n "$shell_path" ]; then
    shell_name=$(basename -- "$shell_path")
  else
    shell_name=$(basename -- "${0:-sh}")
  fi

  case "$shell_name" in
    bash) printf '%s\n' bash ;;
    zsh) printf '%s\n' zsh ;;
    fish) printf '%s\n' fish ;;
    nu|nushell) printf '%s\n' nu ;;
    sh|dash|ksh|mksh) printf '%s\n' sh ;;
    *) printf '%s\n' sh ;;
  esac
}

xdg_config_home() {
  if [ -n "${XDG_CONFIG_HOME:-}" ]; then
    printf '%s\n' "$XDG_CONFIG_HOME"
  else
    printf '%s\n' "$HOME_DIR/.config"
  fi
}

single_quote() {
  printf "%s" "$1" | sed "s/'/'\\\\''/g"
}

ensure_homebrew_on_path() {
  if ! have brew; then
    for candidate in /opt/homebrew/bin/brew /usr/local/bin/brew; do
      if [ -x "$candidate" ]; then
        PATH="$(dirname -- "$candidate"):$PATH"
        export PATH
        break
      fi
    done
  fi
}

configure_homebrew_for_shell() {
  brew_prefix=$1
  shell_name=$2
  brew_bin="$brew_prefix/bin/brew"

  case "$shell_name" in
    bash)
      append_once "$HOME_DIR/.bash_profile" "eval \"\$($brew_bin shellenv)\""
      append_once "$HOME_DIR/.profile" "eval \"\$($brew_bin shellenv)\""
      ;;
    zsh)
      append_once "$HOME_DIR/.zprofile" "eval \"\$($brew_bin shellenv)\""
      ;;
    fish)
      append_once "$(xdg_config_home)/fish/config.fish" "$brew_bin shellenv fish | source"
      ;;
    nu)
      config_dir="$(xdg_config_home)/nushell"
      env_file="$config_dir/env.nu"
      quoted_prefix=$(single_quote "$brew_prefix")
      append_once "$env_file" "\$env.HOMEBREW_PREFIX = '$quoted_prefix'"
      append_once "$env_file" "\$env.HOMEBREW_CELLAR = '$quoted_prefix/Cellar'"
      append_once "$env_file" "\$env.HOMEBREW_REPOSITORY = '$quoted_prefix'"
      append_once "$env_file" "\$env.PATH = (\$env.PATH | prepend '$quoted_prefix/bin' | prepend '$quoted_prefix/sbin')"
      ;;
    sh|*)
      append_once "$HOME_DIR/.profile" "eval \"\$($brew_bin shellenv)\""
      ;;
  esac
}

ensure_homebrew_shellenv() {
  ensure_homebrew_on_path

  if have brew; then
    brew_prefix=$(brew --prefix)
    if [ -x "$brew_prefix/bin/brew" ]; then
      eval "$("$brew_prefix/bin/brew" shellenv)"
      configure_homebrew_for_shell "$brew_prefix" "$(detect_shell_name)"
    fi
  fi
}

install_homebrew_if_needed() {
  if [ "$OS_NAME" != "Darwin" ]; then
    log "Homebrew installation is macOS-only in this bootstrap; skipping on $OS_NAME/$ARCH_NAME."
    ensure_homebrew_shellenv
    return
  fi

  if have brew && [ "$force" -eq 0 ]; then
    log "Homebrew already installed; skipping."
    ensure_homebrew_shellenv
    return
  fi

  if have brew; then
    if ask_yes_no "Homebrew is already installed. Update it now?"; then
      brew update
      needs_refresh=1
    else
      log "Skipped Homebrew update."
    fi
    ensure_homebrew_shellenv
    return
  fi

  if ask_yes_no "Homebrew is not installed. Install Homebrew now?"; then
    log "Installing Homebrew using the official installer."
    NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    needs_refresh=1
    ensure_homebrew_shellenv
  else
    log "Skipped Homebrew installation."
  fi
}

find_mise_bin() {
  if have mise; then
    command -v mise
    return
  fi

  for candidate in "$HOME_DIR/.local/bin/mise" "$HOME_DIR/.local/share/mise/bin/mise"; do
    if [ -x "$candidate" ]; then
      printf '%s\n' "$candidate"
      return
    fi
  done

  return 1
}

ensure_mise_on_path() {
  for dir in "$HOME_DIR/.local/bin" "$HOME_DIR/.local/share/mise/bin"; do
    case ":$PATH:" in
      *":$dir:"*) ;;
      *) PATH="$dir:$PATH" ;;
    esac
  done
  export PATH
}

configure_mise_for_shell() {
  mise_bin=$1
  shell_name=$2

  case "$shell_name" in
    bash)
      append_once "$HOME_DIR/.bashrc" "eval \"\$($mise_bin activate bash)\""
      ;;
    zsh)
      append_once "$HOME_DIR/.zshrc" "eval \"\$($mise_bin activate zsh)\""
      ;;
    fish)
      append_once "$(xdg_config_home)/fish/config.fish" "$mise_bin activate fish | source"
      ;;
    nu)
      config_home=$(xdg_config_home)
      init_dir="$config_home/mise"
      init_file="$init_dir/init.nu"
      env_file="$config_home/nushell/env.nu"
      mkdir -p "$init_dir"
      "$mise_bin" activate nu > "$init_file"
      append_once "$env_file" "source '$init_file'"
      ;;
    sh|*)
      append_once "$HOME_DIR/.profile" "export PATH=\"\$HOME/.local/share/mise/shims:\$HOME/.local/bin:\$PATH\""
      ;;
  esac
}

install_mise_if_needed() {
  ensure_mise_on_path

  mise_bin=$(find_mise_bin 2>/dev/null || true)
  mise_version=""
  if [ -n "$mise_bin" ]; then
    mise_version=$("$mise_bin" --version | awk '{print $1}')
  fi

  if [ -n "$mise_bin" ] && version_ge "$mise_version" "$MISE_MIN_VERSION" && [ "$force" -eq 0 ]; then
    log "mise $mise_version already satisfies minimum $MISE_MIN_VERSION; skipping install."
  else
    if ask_yes_no "Install or update mise to $MISE_INSTALL_VERSION using the native installer?"; then
      log "Installing mise $MISE_INSTALL_VERSION using the native installer."
      curl -fsSL https://mise.run | MISE_VERSION="$MISE_INSTALL_VERSION" sh
      needs_refresh=1
      mise_installed_or_updated=1
      ensure_mise_on_path
      mise_bin=$(find_mise_bin)
    else
      log "Skipped mise installation."
    fi
  fi

  mise_bin=$(find_mise_bin 2>/dev/null || true)
  if [ -z "$mise_bin" ]; then
    log "mise is required to continue bootstrap setup/check tasks."
    return 1
  fi

  mise_version=$("$mise_bin" --version | awk '{print $1}')
  if ! version_ge "$mise_version" "$MISE_MIN_VERSION"; then
    log "mise $mise_version is below required minimum $MISE_MIN_VERSION."
    return 1
  fi

  configure_mise_for_shell "$mise_bin" "$(detect_shell_name)"

  if [ "$mise_installed_or_updated" -eq 1 ]; then
    if "$mise_bin" self-update "$MISE_INSTALL_VERSION" --yes >/dev/null 2>&1; then
      log "mise self-update checked $MISE_INSTALL_VERSION."
    else
      log "mise self-update is unavailable for this installation method; continuing."
    fi
  fi

  eval "$("$mise_bin" env -s bash -C "$ROOT_DIR")"
}

install_colima_if_needed() {
  if have colima && [ "$force" -eq 0 ]; then
    log "Colima already installed; skipping."
    return
  fi

  ensure_homebrew_on_path
  if ! have brew; then
    log "Colima automatic installation requires Homebrew; skipping."
    return
  fi

  if have colima; then
    prompt="Colima is already installed. Update it through Homebrew now?"
  else
    prompt="Colima is not installed. Install it through Homebrew now?"
  fi

  if ask_yes_no "$prompt"; then
    if brew list --formula colima >/dev/null 2>&1; then
      brew upgrade colima || true
    else
      brew install colima
    fi
    needs_refresh=1
  else
    log "Skipped Colima installation/update."
  fi
}

run_mise_task() {
  mise_bin=$1
  task=$2

  if [ "$force" -eq 1 ]; then
    "$mise_bin" run --force "$task"
  else
    "$mise_bin" run "$task"
  fi
}

main() {
  cd "$ROOT_DIR"

  log "Bootstrapping Migaki on $OS_NAME/$ARCH_NAME for $(detect_shell_name)."

  install_homebrew_if_needed
  install_mise_if_needed
  install_colima_if_needed

  if [ "$needs_refresh" -eq 1 ]; then
    ensure_homebrew_shellenv
    log "Refreshed this bootstrap session after installer changes."
  fi

  mise_bin=$(find_mise_bin)

  "$mise_bin" trust "$ROOT_DIR/mise.toml" --yes
  if [ "$force" -eq 1 ]; then
    "$mise_bin" install --force --yes
  else
    "$mise_bin" install --yes
  fi
  "$mise_bin" upgrade --local --yes
  run_mise_task "$mise_bin" setup
  run_mise_task "$mise_bin" check

  log "Bootstrap complete."
}

main "$@"
