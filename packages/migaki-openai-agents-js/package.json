{
  "name": "migaki-openai-agents-js",
  "version": "0.0.0",
  "description": "Migaki instrumentation for the OpenAI Agents SDK for JavaScript.",
  "type": "module",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json --pretty false",
    "prepack": "pnpm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "migaki-openai-agents-js": "./dist/cli.js"
  },
  "peerDependencies": {
    "@openai/agents": ">=0.10.0 <=0.12.0"
  },
  "devDependencies": {
    "@openai/agents": "0.12.0"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "sideEffects": false
}
