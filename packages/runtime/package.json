{
  "name": "@migaki/runtime",
  "version": "0.0.0",
  "description": "Planner, pass runner, evidence, tracing, and replay plumbing for Migaki execution plans.",
  "type": "module",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json --pretty false",
    "prepack": "pnpm run build"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "dependencies": {
    "@migaki/mir": "workspace:*",
    "@migaki/providers": "workspace:*"
  },
  "files": [
    "README.md",
    "dist",
    "src"
  ],
  "sideEffects": false
}
