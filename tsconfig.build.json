{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true,
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo"
  },
  "exclude": [
    "coverage",
    "dist",
    "node_modules",
    "**/*.e2e.test.ts",
    "**/*.spec.ts",
    "**/*.test.ts"
  ]
}
